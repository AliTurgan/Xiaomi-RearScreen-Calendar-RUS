<?xml version="1.0" encoding="utf-8"?>
<Widget version="2" screenWidth="1080" frameRate="30" disableCutRoundCorner="true" transparentSurface="true">

    <Var name="is_aod" type="number" expression="0" const="true"/>

    <Var name="q200Width" type="number" expression="904"/>
    <Var name="q200Height" type="number" expression="572"/>
    <Var name="q200ScreenRatio" type="number" expression="(#q200Width / #q200Height)"/>
    <Var name="p2Width" type="number" expression="976"/>
    <Var name="p2Height" type="number" expression="596"/>
    <Var name="p2ScreenRatio" type="number" expression="(#p2Width / #p2Height)"/>
    
    <Var name="realScreenRatio" type="number" expression="(#view_width / #view_height)"/>
    <Var name="diffWithQ200" type="number" expression="abs((#realScreenRatio - #q200ScreenRatio))"/>
    <Var name="diffWithP2" type="number" expression="abs((#realScreenRatio - #p2ScreenRatio))"/>
    <Var name="isQ200" type="number" expression="(#diffWithQ200 { #diffWithP2)"/>
    <Var name="scale" type="number" expression="ifelse(#isQ200,(#view_width / 336),((#view_width / 364) * 1.047))"/>

    <Var name="w0" expression="(#day_of_week+5)%7"/>
    <Var name="day1_week" expression="(#w0 - (#date-1)%7 + 7)%7"/>
    <Var name="leap_year" expression="eq((#year%4),0)*ne((#year%100),0)+eq((#year%400),0)"/>
    <Var name="display29" expression="#leap_year+ne((#month+1),2)"/>
    <Var name="display30" expression="ne((#month+1),2)"/>
    <Var name="display31" expression="eq((#month+1),1)+eq((#month+1),3)+eq((#month+1),5)+eq((#month+1),7)+eq((#month+1),8)+eq((#month+1),10)+eq((#month+1),12)"/>

    <Var name="grid_w" expression="(33 * #scale)"/>
    <Var name="grid_h" expression="(25 * #scale)"/>
    <Var name="grid_x" expression="(120 * #scale)"/>
    <Var name="grid_y" expression="(80 * #scale)"/>

    <Rectangle x="0" y="0" w="#view_width" h="#view_height" fillColor="#000000" />
    <Rectangle name="bg_normal" folmeMode="true" x="0" y="0" w="#view_width" h="#view_height" fillColor="#111111" />

    <Group name="calendar_group" folmeMode="true">
        <DateTime x="#grid_x - (6 * #scale)" y="(18 * #scale)" color="#FFFFFF" size="(18 * #scale)" bold="true" format="yyyy年M月" />

        <Text text="一" x="#grid_x+0*#grid_w" y="#grid_y-(25*#scale)" color="#888888" size="(10 * #scale)" align="center" alignV="center"/>
        <Text text="二" x="#grid_x+1*#grid_w" y="#grid_y-(25*#scale)" color="#888888" size="(10 * #scale)" align="center" alignV="center"/>
        <Text text="三" x="#grid_x+2*#grid_w" y="#grid_y-(25*#scale)" color="#888888" size="(10 * #scale)" align="center" alignV="center"/>
        <Text text="四" x="#grid_x+3*#grid_w" y="#grid_y-(25*#scale)" color="#888888" size="(10 * #scale)" align="center" alignV="center"/>
        <Text text="五" x="#grid_x+4*#grid_w" y="#grid_y-(25*#scale)" color="#888888" size="(10 * #scale)" align="center" alignV="center"/>
        <Text text="六" x="#grid_x+5*#grid_w" y="#grid_y-(25*#scale)" color="#FF5555" size="(10 * #scale)" align="center" alignV="center"/>
        <Text text="日" x="#grid_x+6*#grid_w" y="#grid_y-(25*#scale)" color="#FF5555" size="(10 * #scale)" align="center" alignV="center"/>

        <Text text="1" visibility="ne(#date,1)" x="#grid_x+(#day1_week)%7*#grid_w" y="#grid_y+int((#day1_week)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="2" visibility="ne(#date,2)" x="#grid_x+(#day1_week+1)%7*#grid_w" y="#grid_y+int((#day1_week+1)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="3" visibility="ne(#date,3)" x="#grid_x+(#day1_week+2)%7*#grid_w" y="#grid_y+int((#day1_week+2)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="4" visibility="ne(#date,4)" x="#grid_x+(#day1_week+3)%7*#grid_w" y="#grid_y+int((#day1_week+3)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="5" visibility="ne(#date,5)" x="#grid_x+(#day1_week+4)%7*#grid_w" y="#grid_y+int((#day1_week+4)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="6" visibility="ne(#date,6)" x="#grid_x+(#day1_week+5)%7*#grid_w" y="#grid_y+int((#day1_week+5)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="7" visibility="ne(#date,7)" x="#grid_x+(#day1_week+6)%7*#grid_w" y="#grid_y+int((#day1_week+6)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="8" visibility="ne(#date,8)" x="#grid_x+(#day1_week+7)%7*#grid_w" y="#grid_y+int((#day1_week+7)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="9" visibility="ne(#date,9)" x="#grid_x+(#day1_week+8)%7*#grid_w" y="#grid_y+int((#day1_week+8)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="10" visibility="ne(#date,10)" x="#grid_x+(#day1_week+9)%7*#grid_w" y="#grid_y+int((#day1_week+9)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="11" visibility="ne(#date,11)" x="#grid_x+(#day1_week+10)%7*#grid_w" y="#grid_y+int((#day1_week+10)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="12" visibility="ne(#date,12)" x="#grid_x+(#day1_week+11)%7*#grid_w" y="#grid_y+int((#day1_week+11)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="13" visibility="ne(#date,13)" x="#grid_x+(#day1_week+12)%7*#grid_w" y="#grid_y+int((#day1_week+12)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="14" visibility="ne(#date,14)" x="#grid_x+(#day1_week+13)%7*#grid_w" y="#grid_y+int((#day1_week+13)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="15" visibility="ne(#date,15)" x="#grid_x+(#day1_week+14)%7*#grid_w" y="#grid_y+int((#day1_week+14)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="16" visibility="ne(#date,16)" x="#grid_x+(#day1_week+15)%7*#grid_w" y="#grid_y+int((#day1_week+15)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="17" visibility="ne(#date,17)" x="#grid_x+(#day1_week+16)%7*#grid_w" y="#grid_y+int((#day1_week+16)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="18" visibility="ne(#date,18)" x="#grid_x+(#day1_week+17)%7*#grid_w" y="#grid_y+int((#day1_week+17)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="19" visibility="ne(#date,19)" x="#grid_x+(#day1_week+18)%7*#grid_w" y="#grid_y+int((#day1_week+18)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="20" visibility="ne(#date,20)" x="#grid_x+(#day1_week+19)%7*#grid_w" y="#grid_y+int((#day1_week+19)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="21" visibility="ne(#date,21)" x="#grid_x+(#day1_week+20)%7*#grid_w" y="#grid_y+int((#day1_week+20)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="22" visibility="ne(#date,22)" x="#grid_x+(#day1_week+21)%7*#grid_w" y="#grid_y+int((#day1_week+21)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="23" visibility="ne(#date,23)" x="#grid_x+(#day1_week+22)%7*#grid_w" y="#grid_y+int((#day1_week+22)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="24" visibility="ne(#date,24)" x="#grid_x+(#day1_week+23)%7*#grid_w" y="#grid_y+int((#day1_week+23)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="25" visibility="ne(#date,25)" x="#grid_x+(#day1_week+24)%7*#grid_w" y="#grid_y+int((#day1_week+24)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="26" visibility="ne(#date,26)" x="#grid_x+(#day1_week+25)%7*#grid_w" y="#grid_y+int((#day1_week+25)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="27" visibility="ne(#date,27)" x="#grid_x+(#day1_week+26)%7*#grid_w" y="#grid_y+int((#day1_week+26)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="28" visibility="ne(#date,28)" x="#grid_x+(#day1_week+27)%7*#grid_w" y="#grid_y+int((#day1_week+27)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>

        <Text text="29" visibility="#display29*ne(#date,29)" x="#grid_x+(#day1_week+28)%7*#grid_w" y="#grid_y+int((#day1_week+28)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="30" visibility="#display30*ne(#date,30)" x="#grid_x+(#day1_week+29)%7*#grid_w" y="#grid_y+int((#day1_week+29)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>
        <Text text="31" visibility="#display31*ne(#date,31)" x="#grid_x+(#day1_week+30)%7*#grid_w" y="#grid_y+int((#day1_week+30)/7)*#grid_h" color="#FFFFFF" size="(11 * #scale)" align="center" alignV="center"/>

        <Text textExp="#date" x="#grid_x+(#day1_week+#date-1)%7*#grid_w" y="#grid_y+int((#day1_week+#date-1)/7)*#grid_h" color="#FF6600" size="(15 * #scale)" bold="true" align="center" alignV="center"/>
    </Group>

    <Group>
        <FolmeState name="bg_aod_enter" alpha="0"/>
        <FolmeConfig name="bg_aod_enter_cfg" ease="-2, 1,0.5"/>
        <FolmeState name="bg_aod_exit" alpha="255"/>
        <FolmeConfig name="bg_aod_exit_cfg" ease="-2, 1,0.5"/>

        <FolmeState name="content_aod_enter" alpha="150"/>
        <FolmeConfig name="content_aod_enter_cfg" ease="-2, 1,0.72" onComplete="'folme_oncomplete_aod'"/>
        <Function name="folme_oncomplete_aod">
            <FrameRateCommand rate="0"/>
        </Function>

        <FolmeState name="content_aod_exit" alpha="255"/>
        <FolmeConfig name="content_aod_exit_cfg" ease="-2, 1,0.72"/>
    </Group>

    <ExternalCommands>
        <Trigger action="enterAod">
            <VariableCommand name="is_aod" expression="1" type="number"/>
            <FolmeCommand target="bg_normal" states="'bg_aod_enter'" config="'bg_aod_enter_cfg'" command="to"/>
            <FolmeCommand target="calendar_group" states="'content_aod_enter'" config="'content_aod_enter_cfg'" command="to"/>
        </Trigger>

        <Trigger action="exitAod">
            <VariableCommand name="is_aod" expression="0" type="number"/>
            <FrameRateCommand rate="30"/>
            <FolmeCommand target="bg_normal" states="'bg_aod_exit'" config="'bg_aod_exit_cfg'" command="to"/>
            <FolmeCommand target="calendar_group" states="'content_aod_exit'" config="'content_aod_exit_cfg'" command="to"/>
        </Trigger>

        <Trigger action="pause">
            <FrameRateCommand rate="0"/>
        </Trigger>

        <Trigger action="resume">
            <MultiCommand condition="(! #is_aod)">
                <FrameRateCommand rate="30"/>
            </MultiCommand>
        </Trigger>
    </ExternalCommands>

</Widget>