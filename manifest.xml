            <Group name="events_group_normal" folmeMode="true" alpha="0" x="0" y="44*#scaleY_boc59f">
                <Array count="6" indexName="__rc">
                    <Group x="12*#scale_boc59f+int(#__rc%2)*94*#scale_boc59f" y="int(#__rc/2)*50*#scaleY_boc59f" w="88*#scale_boc59f" h="46*#scaleY_boc59f" visibility="gt(#hasEvents,#__rc)">
                        <Rectangle x="0" y="0" w="88*#scale_boc59f" h="46*#scaleY_boc59f" cornerRadiusExp="10*#scale_boc59f" fillColor="#000000" alpha="10"/>
                        <Rectangle x="0" y="0" w="4*#scale_boc59f" h="46*#scaleY_boc59f" cornerRadiusExp="2*#scale_boc59f" fillColorExp="argb(255,#rcbg_r[#__rc],#rcbg_g[#__rc],#rcbg_b[#__rc])"/>
                        <Text textExp="ifelse(eqs(@calendar_allDay[#__rc],'1'),'Весь день',ifelse(strIsEmpty(@calendar_dtend[#__rc]),formatDate('HH:mm',@calendar_dtstart[#__rc]),formatDate('HH:mm',@calendar_dtstart[#__rc])+'-'+formatDate('HH:mm',@calendar_dtend[#__rc])))" x="10*#scale_boc59f" y="13*#scaleY_boc59f" color="#FFFFFF" size="10*#scale_boc59f" alignV="center" fontFamily="mipro-demibold"/>
